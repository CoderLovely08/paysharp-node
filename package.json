{
  "name": "paysharp-node",
  "version": "0.1.0",
  "description": "Unofficial type-safe Node.js SDK for the PaySharp v1 REST APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Lovely Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderLovely08/paysharp-node.git"
  },
  "homepage": "https://github.com/CoderLovely08/paysharp-node#readme",
  "bugs": {
    "url": "https://github.com/CoderLovely08/paysharp-node/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "tsc --noEmit",
    "docs:generate": "typedoc",
    "lint": "eslint src",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run lint && npm run check && npm test"
  },
  "keywords": [
    "paysharp",
    "payments",
    "upi",
    "payment-gateway",
    "nodejs",
    "typescript"
  ],
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "eslint": "^10.9.1",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
